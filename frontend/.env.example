# Safe browser-public configuration only (docs/12-configuration-and-secrets.md §11).
# Never place a provider key, LiveKit secret, or MongoDB URI in this file or any
# frontend/.env* file. All VITE_* values are embedded in the browser bundle.

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_ENV=development
VITE_BUILD_VERSION=0.0.0-dev
